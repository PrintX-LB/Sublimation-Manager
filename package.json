{
  "name": "sublimation-admin",
  "version": "0.9.0-beta.2",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:migrations:clean": "node scripts/verify-clean-install.mjs --repeat",
    "verify:clean-install": "node scripts/verify-clean-install.mjs --repeat",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "desktop:dev": "electron desktop/main.cjs --development",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir --x64",
    "desktop:portable": "npm run desktop:prepare && electron-builder --win portable --x64",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win portable nsis --x64"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "adm-zip": "^0.5.14",
    "bcryptjs": "^2.4.3",
    "fabric": "^7.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.10",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "build": {
    "appId": "com.printx.desktop",
    "productName": "PrintX",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/engines/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop-dist/app-server",
        "to": "app-server",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "desktop-dist/app-server/node_modules",
        "to": "app-server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      }
    ],
    "win": {
      "executableName": "PrintX",
      "artifactName": "PrintX-Desktop-Beta-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintX"
    }
  }
}
