{
  "name": "sublimation-admin",
  "version": "1.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:migrations:clean": "node scripts/verify-clean-install.mjs --repeat",
    "verify:clean-install": "node scripts/verify-clean-install.mjs --repeat",
    "clean:build": "node scripts/storage-maintenance.mjs clean-build",
    "clean:test": "node scripts/storage-maintenance.mjs clean-test",
    "clean:release": "node scripts/storage-maintenance.mjs clean-release",
    "clean": "node scripts/storage-maintenance.mjs clean",
    "disk:audit": "node scripts/storage-maintenance.mjs audit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "desktop:dev": "electron desktop/main.cjs --development",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --dir --x64",
    "desktop:portable": "npm run clean:build && npm run clean:release && npm run desktop:prepare && electron-builder --win portable --x64 --config.directories.output=release-artwork-fix",
    "desktop:dist": "npm run clean:build && npm run clean:release && npm run desktop:prepare && electron-builder --win portable nsis --x64 --config.directories.output=release-artwork-fix"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "adm-zip": "^0.5.14",
    "bcryptjs": "^2.4.3",
    "fabric": "^7.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.10",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "build": {
    "appId": "com.printx.desktop",
    "productName": "PrintX",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/engines/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/prisma/**/*",
      "node_modules/@prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@standard-schema/**/*",
      "node_modules/anymatch/**/*",
      "node_modules/binary-extensions/**/*",
      "node_modules/braces/**/*",
      "node_modules/c12/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/citty/**/*",
      "node_modules/confbox/**/*",
      "node_modules/consola/**/*",
      "node_modules/deepmerge-ts/**/*",
      "node_modules/defu/**/*",
      "node_modules/destr/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/effect/**/*",
      "node_modules/empathic/**/*",
      "node_modules/exsolve/**/*",
      "node_modules/fast-check/**/*",
      "node_modules/fill-range/**/*",
      "node_modules/giget/**/*",
      "node_modules/glob-parent/**/*",
      "node_modules/is-binary-path/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/is-number/**/*",
      "node_modules/jiti/**/*",
      "node_modules/node-fetch-native/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/nypm/**/*",
      "node_modules/ohash/**/*",
      "node_modules/pathe/**/*",
      "node_modules/perfect-debounce/**/*",
      "node_modules/picomatch/**/*",
      "node_modules/pkg-types/**/*",
      "node_modules/pure-rand/**/*",
      "node_modules/rc9/**/*",
      "node_modules/readdirp/**/*",
      "node_modules/tinyexec/**/*",
      "node_modules/to-regex-range/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.test.*",
      "!node_modules/**/*.spec.*",
      "!node_modules/**/__tests__/**"
    ],
    "extraResources": [
      {
        "from": "desktop-dist/app-server",
        "to": "app-server",
        "filter": [
          "**/*",
          "!node_modules/**/*",
          "!**/*.map",
          "!**/*.md",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/playwright-report/**",
          "!**/test-results/**",
          "!**/coverage/**"
        ]
      },
      {
        "from": "desktop-dist/app-server/node_modules",
        "to": "app-server/node_modules",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.md",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/playwright-report/**",
          "!**/test-results/**",
          "!**/coverage/**"
        ]
      },
      {
        "from": "prisma/schema.prisma",
        "to": "prisma/schema.prisma"
      },
      {
        "from": "prisma/migrations",
        "to": "prisma/migrations"
      }
    ],
    "win": {
      "executableName": "PrintX",
      "artifactName": "PrintX-Desktop-Beta-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintX"
    }
  }
}
